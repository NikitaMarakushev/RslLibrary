<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">РГБ</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="sidebar-scroll">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill" aria-hidden="true"></span> Главная
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="catalog">
                <span class="bi bi-book-fill" aria-hidden="true"></span> Каталог
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="profile">
                        <span class="bi bi-person-fill" aria-hidden="true"></span> Личный кабинет
                    </NavLink>
                </div>

                @if (context.User.IsInRole("Librarian") || context.User.IsInRole("Administrator"))
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="librarian">
                            <span class="bi bi-journal-text" aria-hidden="true"></span> Рабочее место библиотекаря
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="manage-books">
                            <span class="bi bi-collection" aria-hidden="true"></span> Управление фондом
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="dashboard">
                            <span class="bi bi-graph-up" aria-hidden="true"></span> Панель управления
                        </NavLink>
                    </div>
                }

                @if (context.User.IsInRole("Administrator"))
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="admin">
                            <span class="bi bi-shield-lock-fill" aria-hidden="true"></span> Администрирование
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="admin/audit-logs">
                            <span class="bi bi-clipboard-data" aria-hidden="true"></span> Журнал аудита
                        </NavLink>
                    </div>
                }
            </Authorized>
        </AuthorizeView>
    </nav>
</div>