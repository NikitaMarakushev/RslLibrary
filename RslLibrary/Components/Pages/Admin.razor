@page "/admin"
@attribute [Authorize(Roles = "Administrator")]
@inject IUserService UserService
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@using Microsoft.EntityFrameworkCore
@using RslLibrary.Models
@using RslLibrary.Constants

<PageTitle>Администрирование</PageTitle>

<h1>Панель администратора</h1>
@if (!string.IsNullOrEmpty(LoadError))
{
    <div class="alert alert-danger">
        <strong>Ошибка:</strong> @LoadError
    </div>
}

<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="card text-white bg-primary h-100">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-book"></i> Всего книг</h5>
                <h2 class="display-6">@TotalBooks</h2>
                <p class="card-text small">Наименований в каталоге</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-white bg-success h-100">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-people"></i> Читателей</h5>
                <h2 class="display-6">@TotalUsers</h2>
                <p class="card-text small">Зарегистрировано в системе</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-white bg-warning h-100">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-arrow-left-right"></i> Активных выдач</h5>
                <h2 class="display-6">@ActiveLoans</h2>
                <p class="card-text small">Книг на руках у читателей</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-white bg-danger h-100">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-exclamation-triangle"></i> Просрочено</h5>
                <h2 class="display-6">@OverdueLoans</h2>
                <p class="card-text small">Требуют внимания</p>
            </div>
        </div>
    </div>
</div>

<h3>Пользователи системы</h3>

@if (Users == null)
{
    <div class="text-center p-4">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2">Загрузка данных...</p>
    </div>
}
else if (!Users.Any())
{
    <div class="alert alert-info">Пользователи не найдены.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ФИО</th>
                    <th>Email</th>
                    <th>Читательский билет</th>
                    <th>Роли</th>
                    <th>Статус</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Users)
                {
                    <tr>
                        <td><strong>@user.FullName</strong></td>
                        <td>@user.Email</td>
                        <td><code>@user.ReaderTicketNumber</code></td>
                        <td>
                            @foreach (var role in user.Roles)
                            {
                                <span class="badge bg-primary me-1">@role</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-@(user.IsActive ? "success" : "danger")">
                                @(user.IsActive ? "Активен" : "Заблокирован")
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<UserViewModel>? Users;
    private int TotalBooks = 0;
    private int TotalUsers = 0;
    private int ActiveLoans = 0;
    private int OverdueLoans = 0;
    private string? LoadError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Users = (await UserService.GetAllUsersWithRolesAsync()).ToList();
            await LoadStatisticsAsync();
        }
        catch (Exception ex)
        {
            LoadError = $"Ошибка загрузки данных: {ex.Message}";
        }
    }

    private async Task LoadStatisticsAsync()
    {
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            var today = DateOnly.FromDateTime(DateTime.Today);

            TotalBooks = await context.Books.CountAsync();
            TotalUsers = await context.Users.CountAsync();
            ActiveLoans = await context.Loans.CountAsync(l => l.StatusId == LoanStatuses.Active);
            OverdueLoans = await context.Loans.CountAsync(l => l.StatusId == LoanStatuses.Active && l.DueDate < today);
        }
        catch (Exception)
        {
            // Если статистика не загрузилась, оставляем нули, чтобы не ломать страницу
        }
    }
}