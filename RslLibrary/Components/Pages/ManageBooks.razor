@page "/manage-books"
@attribute [Authorize(Roles = "Librarian,Administrator")]
@inject IBookManagementService BookManagementService
@inject ToastService ToastService
@inject IJSRuntime JS
@using RslLibrary.Services


<PageTitle>Управление фондом</PageTitle>

<h1>Управление фондом</h1>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <button class="nav-link @(ActiveTab == "add" ? "active" : "")" @onclick="SwitchToAddTab">
            Добавить книгу
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(ActiveTab == "list" ? "active" : "")" @onclick="SwitchToListTab">
            Список книг
        </button>
    </li>
</ul>

@if (ActiveTab == "add")
{
    <h3>@(IsEditing ? "Редактирование книги" : "Добавление новой книги")</h3>
    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Название книги *</label>
                    <input type="text" class="form-control" @bind="NewBookTitle" placeholder="Введите название" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">ISBN</label>
                    <input type="text" class="form-control" @bind="NewBookIsbn" placeholder="978-5-..." />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Автор *</label>
                    <div class="input-group">
                        <select class="form-select" @bind="NewBookAuthorName">
                            <option value="">-- Выберите автора --</option>
                            @foreach (var author in Authors)
                            {
                                <option value="@author.FullName">@author.FullName</option>
                            }
                        </select>
                        <button class="btn btn-outline-primary" type="button" @onclick="OpenAddAuthorModal" title="Добавить нового автора">
                            <i class="bi bi-plus-lg"></i> Новый автор
                        </button>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Категория *</label>
                    <select class="form-select" @bind="NewBookCategoryName">
                        <option value="">-- Выберите категорию --</option>
                        @foreach (var cat in Categories)
                        {
                            <option value="@cat.Name">@cat.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Год издания</label>
                    <input type="number" class="form-control" @bind="NewBookYear" min="1500" max="2030" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Количество страниц</label>
                    <input type="number" class="form-control" @bind="NewBookPageCount" min="1" />
                </div>
                @if (!IsEditing)
                {
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Инвентарный номер *</label>
                        <input type="text" class="form-control" @bind="InventoryNumber" placeholder="RBG-2026-001" />
                    </div>
                }
            </div>
            <div class="mb-3">
                <label class="form-label">Описание</label>
                <textarea class="form-control" @bind="NewBookDescription" rows="3"></textarea>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-primary" @onclick="SaveBook">
                    @(IsEditing ? "Сохранить изменения" : "Добавить книгу")
                </button>
                @if (IsEditing)
                {
                    <button class="btn btn-secondary" @onclick="CancelEdit">Отмена</button>
                }
            </div>
        </div>
    </div>
}
else if (ActiveTab == "list")
{
    <h3>Список книг в фонде</h3>

    @if (IsLoading)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
            <p class="mt-3">Загрузка списка книг...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(LoadError))
    {
        <div class="alert alert-danger">
            <strong>Ошибка загрузки:</strong> @LoadError
        </div>
    }
    else if (Books == null || !Books.Any())
    {
        <div class="alert alert-warning">
            <i class="bi bi-info-circle"></i> Книги в фонде отсутствуют.
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <strong>Найдено книг:</strong> @Books.Count
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Название</th>
                        <th>Автор</th>
                        <th>Категория</th>
                        <th>Инвентарные номера экземпляров</th>
                        <th>Год</th>
                        <th>Доступно</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var book in Books)
                    {
                        <tr>
                            <td>@book.Id</td>
                            <td>
                                <strong>@book.Title</strong>
                                @if (!string.IsNullOrEmpty(book.Isbn))
                                {
                                    <br /><small class="text-muted">ISBN: @book.Isbn</small>
                                }
                            </td>
                            <td>@book.AuthorFullName</td>
                            <td>@book.CategoryName</td>
                            <td>
                                @if (book.InventoryNumbers != null && book.InventoryNumbers.Any())
                                {
                                    @foreach (var invNum in book.InventoryNumbers)
                                    {
                                        <span class="badge bg-info text-dark me-1 mb-1">@invNum</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">Нет экземпляров</span>
                                }
                            </td>
                            <td>@(book.Year?.ToString() ?? "-")</td>
                            <td>
                                <span class="badge bg-@(book.AvailableCopiesCount > 0 ? "success" : "danger")">
                                    @book.AvailableCopiesCount шт.
                                </span>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditBook(book.Id)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteBook(book.Id, book.Title)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@if (ShowAddAuthorModal)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center"
         style="background-color: rgba(0, 0, 0, 0.5); z-index: 1050;"
         @onclick="CloseAddAuthorModal">

        <div class="modal-content shadow-lg" style="width: 400px; z-index: 1051;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h5 class="modal-title">Новый автор</h5>
                <button type="button" class="btn-close" @onclick="CloseAddAuthorModal"></button>
            </div>
            <div class="modal-body">
                <label class="form-label">ФИО автора *</label>
                <input type="text"
                       class="form-control"
                       @bind="NewAuthorName"
                       @bind:event="oninput"
                       placeholder="Например: Достоевский Федор Михайлович"
                       @onkeydown="HandleEnterKey" />

                @if (!string.IsNullOrEmpty(AddAuthorError))
                {
                    <div class="alert alert-danger py-2 mt-2 mb-0 small">@AddAuthorError</div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseAddAuthorModal">Отмена</button>
                <button type="button" class="btn btn-primary" @onclick="SaveNewAuthor">Сохранить</button>
            </div>
        </div>
    </div>
}

@code {
    private string ActiveTab = "add";
    private bool IsEditing = false;
    private int EditingBookId = 0;

    private string NewBookTitle = "";
    private string NewBookIsbn = "";
    private string NewBookAuthorName = "";
    private string NewBookCategoryName = "";
    private short? NewBookYear;
    private int? NewBookPageCount;
    private string NewBookDescription = "";
    private string InventoryNumber = "";

    private List<RslLibrary.Models.Author> Authors = new();
    private List<RslLibrary.Models.Category> Categories = new();
    private List<BookDto>? Books;
    private bool IsLoading = false;
    private string? LoadError;

    private bool ShowAddAuthorModal = false;
    private string NewAuthorName = "";
    private string AddAuthorError = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Authors = (await BookManagementService.GetAllAuthorsAsync()).ToList();
            Categories = (await BookManagementService.GetAllCategoriesAsync()).ToList();
        }
        catch (Exception ex)
        {
            LoadError = $"Ошибка загрузки справочников: {ex.Message}";
        }
    }

    private void SwitchToAddTab()
    {
        ActiveTab = "add";
        IsEditing = false;
        ClearForm();
    }

    private async Task SwitchToListTab()
    {
        ActiveTab = "list";
        IsEditing = false;
        await LoadBooks();
    }

    private async Task LoadBooks()
    {
        IsLoading = true;
        LoadError = null;
        Books = null;

        try
        {
            var result = await BookManagementService.GetAllBooksAsync();
            Books = result?.ToList() ?? new List<BookDto>();
        }
        catch (Exception ex)
        {
            LoadError = $"Ошибка: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task EditBook(int bookId)
    {
        try
        {
            var book = await BookManagementService.GetBookForEditAsync(bookId);
            if (book == null)
            {
                ToastService.ShowError("Ошибка", "Книга не найдена.");
                return;
            }

            EditingBookId = bookId;
            IsEditing = true;
            ActiveTab = "add";

            NewBookTitle = book.Title;
            NewBookIsbn = book.Isbn ?? "";
            NewBookAuthorName = book.AuthorFullName;
            NewBookCategoryName = book.CategoryName;
            NewBookYear = book.Year;
            NewBookPageCount = book.PageCount;
            NewBookDescription = book.Description ?? "";
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Ошибка", $"Не удалось загрузить данные книги: {ex.Message}");
        }
    }

    private void CancelEdit()
    {
        IsEditing = false;
        EditingBookId = 0;
        ClearForm();
        ActiveTab = "list";
    }

    private async Task SaveBook()
    {
        if (string.IsNullOrWhiteSpace(NewBookTitle) ||
            string.IsNullOrWhiteSpace(NewBookAuthorName) ||
            string.IsNullOrWhiteSpace(NewBookCategoryName))
        {
            ToastService.ShowWarning("Внимание", "Заполните все обязательные поля.");
            return;
        }

        if (!IsEditing && string.IsNullOrWhiteSpace(InventoryNumber))
        {
            ToastService.ShowWarning("Внимание", "Введите инвентарный номер.");
            return;
        }

        var dto = new CreateBookDto
        {
            Title = NewBookTitle,
            Isbn = NewBookIsbn,
            Year = NewBookYear,
            PageCount = NewBookPageCount,
            Description = NewBookDescription,
            AuthorFullName = NewBookAuthorName,
            CategoryName = NewBookCategoryName
        };

        try
        {
            if (IsEditing)
            {
                var success = await BookManagementService.UpdateBookAsync(EditingBookId, dto);
                if (success)
                {
                    ToastService.ShowSuccess("Успех", $"Книга '{NewBookTitle}' обновлена!");
                    IsEditing = false;
                    EditingBookId = 0;
                    ClearForm();
                    await LoadBooks();
                }
                else
                {
                    ToastService.ShowError("Ошибка", "Не удалось обновить книгу.");
                }
            }
            else
            {
                var (success, errorMessage) = await BookManagementService.AddBookAsync(dto, InventoryNumber, null, null);
                if (success)
                {
                    ToastService.ShowSuccess("Успех", $"Книга '{NewBookTitle}' добавлена!");
                    ClearForm();
                }
                else
                {
                    if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        ToastService.ShowError("Ошибка валидации", errorMessage);
                    }
                    else
                    {
                        ToastService.ShowError("Ошибка", "Не удалось добавить книгу. Проверьте введённые данные.");
                    }
                }
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Критическая ошибка", ex.Message);
        }
    }

    private async Task DeleteBook(int bookId, string bookTitle)
    {
        var confirmed = await ShowConfirmDialog($"Вы уверены, что хотите удалить книгу '{bookTitle}'? Это действие нельзя отменить.");

        if (!confirmed)
            return;

        try
        {
            var success = await BookManagementService.DeleteBookAsync(bookId);
            if (success)
            {
                ToastService.ShowSuccess("Успех", $"Книга '{bookTitle}' удалена из каталога.");
                await LoadBooks();
            }
            else
            {
                ToastService.ShowError("Ошибка", "Не удалось удалить книгу.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Критическая ошибка", ex.Message);
        }
    }

    private async Task<bool> ShowConfirmDialog(string message)
    {
        return await JS.InvokeAsync<bool>("confirm", message);
    }

    private void ClearForm()
    {
        NewBookTitle = "";
        NewBookIsbn = "";
        NewBookAuthorName = "";
        NewBookCategoryName = "";
        NewBookYear = null;
        NewBookPageCount = null;
        NewBookDescription = "";
        InventoryNumber = "";
    }

    private void OpenAddAuthorModal()
    {
        NewAuthorName = "";
        AddAuthorError = "";
        ShowAddAuthorModal = true;
    }

    private void CloseAddAuthorModal()
    {
        ShowAddAuthorModal = false;
    }

    private async Task HandleEnterKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SaveNewAuthor();
        }
    }

    private async Task SaveNewAuthor()
    {
        if (string.IsNullOrWhiteSpace(NewAuthorName))
        {
            AddAuthorError = "Введите имя автора.";
            return;
        }

        var (success, errorMessage) = await BookManagementService.AddAuthorAsync(NewAuthorName);

        if (success)
        {
            Authors = (await BookManagementService.GetAllAuthorsAsync()).ToList();

            NewBookAuthorName = NewAuthorName.Trim();

            CloseAddAuthorModal();
            ToastService.ShowSuccess("Успех", $"Автор '{NewAuthorName}' добавлен и выбран!");
        }
        else
        {
            AddAuthorError = errorMessage;
        }
    }
}